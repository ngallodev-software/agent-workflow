{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/benchmark-host-gate-evidence/v1",
  "type": "object",
  "required": [
    "schema",
    "candidate",
    "host",
    "runs",
    "independent_gate",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/benchmark-host-gate-evidence/v1"
    },
    "candidate": {
      "type": "object",
      "required": [
        "version",
        "source_sha256",
        "archive_sha256"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "required": [
        "platform",
        "python",
        "tmux",
        "chromium"
      ],
      "additionalProperties": true
    },
    "runs": {
      "type": "object",
      "required": [
        "codex_fast",
        "claude_fast",
        "full_v2",
        "cancellation"
      ],
      "additionalProperties": true
    },
    "independent_gate": {
      "type": "object",
      "required": [
        "decision",
        "reviewer",
        "report"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject",
            "blocked"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "summary",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "observer": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
