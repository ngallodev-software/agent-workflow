{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/benchmark-host-gate-task-result/v1",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "status",
    "summary",
    "commands",
    "evidence",
    "findings",
    "completed_at"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/benchmark-host-gate-task-result/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "argv",
          "exit_code"
        ],
        "properties": {
          "argv": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
