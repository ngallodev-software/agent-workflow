{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/terminal-event/v1",
  "type": "object",
  "required": ["schema", "session_id", "recorded_at", "pane_id", "content_sha256", "content_bytes", "content"],
  "properties": {
    "schema": {"const": "agent-workflow/terminal-event/v1"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "pane_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "content": {"type": "string", "maxLength": 65536}
  },
  "additionalProperties": false
}
