{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/prompt-pack/v1",
  "type": "object",
  "required": [
    "schema",
    "pack_id",
    "workflow",
    "phases"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/prompt-pack/v1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "minimum_version"
      ],
      "properties": {
        "name": {
          "const": "agent-workflow"
        },
        "minimum_version": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "directory",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "mandatory_order": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "tier",
                "agent_run_id",
                "prompt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "tier": {
                  "type": "string",
                  "minLength": 1
                },
                "agent_run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "result_contract": {
                  "type": "object",
                  "required": [
                    "schema"
                  ],
                  "properties": {
                    "schema": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean",
                      "default": true
                    }
                  },
                  "additionalProperties": false
                },
                "task_type": {
                  "type": "string",
                  "minLength": 1,
                  "default": "implementation"
                },
                "backlog_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "backlog_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
