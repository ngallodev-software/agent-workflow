{
  "$id": "agent-workflow/team-receipt/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\).+"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "journal_id",
        "path",
        "record_count",
        "last_message_id",
        "sha256",
        "size"
      ],
      "properties": {
        "label": {"$ref": "#/$defs/id"},
        "journal_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/relativePath"},
        "record_count": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "last_message_id": {
          "oneOf": [
            {"$ref": "#/$defs/id"},
            {"type": "null"}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "orchestration_id",
    "team_id",
    "hierarchy_identity_sha256",
    "delegation_contract",
    "journals",
    "workers",
    "review_evidence",
    "unresolved_issues",
    "scope_deviations",
    "budget_usage",
    "terminal_disposition",
    "created_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "agent-workflow/team-receipt/v1"},
    "version": {"const": 1},
    "orchestration_id": {"$ref": "#/$defs/id"},
    "team_id": {"$ref": "#/$defs/id"},
    "hierarchy_identity_sha256": {"$ref": "#/$defs/sha256"},
    "delegation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contract_sha256", "file_sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "journals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/journal"}
    },
    "workers": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "artifacts"],
        "properties": {
          "run_id": {"$ref": "#/$defs/id"},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"$ref": "#/$defs/artifact"}
          }
        }
      }
    },
    "review_evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "unresolved_issues": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 8192}
    },
    "scope_deviations": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 8192}
    },
    "budget_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers_started",
        "peak_concurrent_workers",
        "peak_interactive_panes",
        "retries",
        "wall_seconds"
      ],
      "properties": {
        "workers_started": {"type": "integer", "minimum": 0, "maximum": 4096},
        "peak_concurrent_workers": {"type": "integer", "minimum": 0, "maximum": 1024},
        "peak_interactive_panes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "retries": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "wall_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000}
      }
    },
    "terminal_disposition": {
      "enum": ["completed", "failed", "blocked", "cancelled", "rejected"]
    },
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  }
}
