{
  "$id": "agent-workflow/orchestration-hierarchy/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "boundedStringList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "orchestration_id",
    "root_orchestrator_id",
    "workflow_id",
    "allowed_depth",
    "budgets",
    "allowed",
    "allowed_routes",
    "teams",
    "source",
    "created_at",
    "identity_sha256"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/orchestration-hierarchy/v1"
    },
    "version": {
      "const": 1
    },
    "orchestration_id": {
      "$ref": "#/$defs/id"
    },
    "root_orchestrator_id": {
      "$ref": "#/$defs/id"
    },
    "workflow_id": {
      "$ref": "#/$defs/id"
    },
    "allowed_depth": {
      "const": 2
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_teams",
        "max_total_workers",
        "max_concurrent_workers",
        "max_retries_per_worker",
        "max_wall_seconds"
      ],
      "properties": {
        "max_teams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_total_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_concurrent_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_retries_per_worker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      }
    },
    "allowed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executors",
        "models",
        "agent_classes",
        "permissions",
        "commands"
      ],
      "properties": {
        "executors": {
          "$ref": "#/$defs/boundedStringList"
        },
        "models": {
          "$ref": "#/$defs/boundedStringList"
        },
        "agent_classes": {
          "$ref": "#/$defs/boundedStringList"
        },
        "permissions": {
          "$ref": "#/$defs/boundedStringList"
        },
        "commands": {
          "$ref": "#/$defs/boundedStringList"
        }
      }
    },
    "allowed_routes": {
      "$ref": "#/$defs/boundedStringList"
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "team_id",
          "team_lead_agent_run_id",
          "parent_principal"
        ],
        "properties": {
          "team_id": {
            "$ref": "#/$defs/id"
          },
          "team_lead_agent_run_id": {
            "$ref": "#/$defs/id"
          },
          "parent_principal": {
            "const": "root"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "snapshot_sha256",
        "prompt_pack_id",
        "prompt_pack_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_pack_id": {
          "$ref": "#/$defs/id"
        },
        "prompt_pack_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  }
}
