{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/command/v1",
  "type": "object",
  "required": [
    "argv",
    "classification",
    "executor",
    "interactive_stdio",
    "mode",
    "schema",
    "shell",
    "stream_format"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/command/v1"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "shell": {
      "type": "string"
    },
    "executor": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "enum": [
        "named",
        "unclassified"
      ]
    },
    "stream_format": {
      "enum": [
        "text",
        "codex-jsonl",
        "claude-stream-json"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "no_go_authorized": {
      "type": "boolean"
    },
    "agent_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "enum": [
        "headless",
        "external"
      ]
    },
    "interactive_stdio": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
