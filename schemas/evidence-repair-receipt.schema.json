{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/evidence-repair-receipt/v1",
  "type": "object",
  "required": ["schema", "repair_id", "source_session_id", "source_final_receipt_sha256", "sealed_at", "artifacts"],
  "properties": {
    "schema": {"const": "agent-workflow/evidence-repair-receipt/v1"},
    "repair_id": {"type": "string", "minLength": 1},
    "source_session_id": {"type": "string", "minLength": 1},
    "source_final_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sealed_at": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
