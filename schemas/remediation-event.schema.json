{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/remediation-event/v1",
  "type": "object",
  "required": ["schema", "event_id", "session_id", "incident_id", "recorded_at", "rule_id", "action", "outcome", "reason", "details"],
  "properties": {
    "schema": {"const": "agent-workflow/remediation-event/v1"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "incident_id": {"type": ["string", "null"], "maxLength": 64},
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "outcome": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "details": {"type": "object", "maxProperties": 64}
  },
  "additionalProperties": false
}
