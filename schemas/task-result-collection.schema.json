    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "stored_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "stored_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation_status": {
      "enum": [
        "not-configured",
        "missing",
        "valid",
        "invalid"
      ]
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collected_at": {
      "type": "string"
    }
