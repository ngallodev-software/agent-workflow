{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/index-integrity-disposition/v1",
  "type": "object",
  "required": ["schema", "incident_id", "actor", "decision", "reason", "decided_at"],
  "properties": {
    "schema": {"const": "agent-workflow/index-integrity-disposition/v1"},
    "incident_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"type": "string", "minLength": 1},
    "decision": {"enum": ["resolved", "reopened"]},
    "reason": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
