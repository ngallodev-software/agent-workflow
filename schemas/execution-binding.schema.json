{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "agent-workflow/execution-binding/v1"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "agent-workflow/task-chain/v1"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "pack": {
          "type": "string",
          "minLength": 1
        },
        "planning_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "predecessors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "job_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "task_id",
              "predecessors",
              "job_sha256"
            ]
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "transition_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "argv",
              "cwd",
              "timeout_seconds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "cwd": {
                "type": "string"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "minItems": 1
        },
        "final_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "argv",
              "cwd",
              "timeout_seconds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "cwd": {
                "type": "string"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "minItems": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      },
      "required": [
        "schema",
        "created_at",
        "repo",
        "pack",
        "planning_revision",
        "source_specification_sha256",
        "tasks",
        "order",
        "transition_commands",
        "final_commands",
        "actor",
        "reason",
        "plan_sha256",
        "tier"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "prior_integration": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "plan",
    "task_id",
    "run_id",
    "worktree",
    "execution_revision",
    "prior_integration"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/execution-binding/v1"
}
