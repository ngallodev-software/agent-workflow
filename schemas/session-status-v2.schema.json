{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/session-status/v2",
  "type": "object",
  "required": [
    "schema",
    "session_id",
    "status",
    "created_at",
    "workdir",
    "prompt_path",
    "log_path"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/session-status/v2"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "ticket_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pack_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "launched",
        "running",
        "interruption_requested",
        "completed",
        "failed",
        "interrupted",
        "killed"
      ]
    },
    "disposition": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "reviewed",
        "accepted",
        "force-accepted",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "workdir": {
      "type": "string"
    },
    "prompt_path": {
      "type": "string"
    },
    "log_path": {
      "type": "string"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completion_json_path": {
      "type": "string"
    },
    "provenance_path": {
      "type": "string"
    },
    "events_path": {
      "type": "string"
    },
    "final_receipt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "tmux_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "shared_window",
        "dedicated_session"
      ]
    },
    "tmux_session": {
      "type": [
        "string",
        "null"
      ]
    },
    "tmux_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "tmux_pane_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^%[0-9]+$"
    },
    "tmux_window_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "pane_pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pane_command": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_binding_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_binding_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "executor_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "completed",
        "failed",
        "interrupted",
        "killed",
        "lost"
      ]
    },
    "completion_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "valid",
        "missing",
        "invalid"
      ]
    },
    "policy_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "passed",
        "failed",
        "not_evaluated"
      ]
    },
    "policy_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_failure_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_eligible": {
      "type": "boolean"
    },
    "budget_exceeded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projection_generated_at": {
      "type": "string"
    },
    "projection_source": {
      "type": "string"
    },
    "projection_freshness": {
      "enum": [
        "snapshot",
        "live"
      ]
    },
    "projection_authority": {
      "const": "cache"
    },
    "tmux_alive": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "terminal_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_failure_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_semantic_progress_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_semantic_progress_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_health": {
      "type": "object"
    },
    "permission_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_permission_event": {
      "type": [
        "object",
        "null"
      ]
    },
    "output_capture_exhausted": {
      "type": "boolean"
    },
    "evaluation_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "not_planned",
        "verified",
        "not_verified"
      ]
    },
    "evaluation_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "pass",
        "fail",
        "invalid"
      ]
    },
    "attempt_classification": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "integrity-unverified",
        "completion-missing",
        "completion-invalid",
        "policy-failed",
        "executor-failed",
        "executor-interrupted",
        "executor-killed",
        "executor-lost",
        "acceptance-eligible",
        "completed-not-accepted",
        "terminal-unclassified"
      ]
    },
    "ledger_row_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluation_report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluation_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
