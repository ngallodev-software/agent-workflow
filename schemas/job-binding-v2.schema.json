{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/job-binding/v2",
  "type": "object",
  "required": [
    "schema", "bound_at", "agent_run_id", "run_dir", "job_id", "ticket_id",
    "pack_root", "worktree", "worktree_target", "prompt_source_path",
    "job_source_path", "job_source_sha256", "job_stored_path", "job_stored_sha256",
    "source_specification", "path_policy", "acceptance_commands", "review_requirement"
  ],
  "properties": {
    "schema": {"const": "agent-workflow/job-binding/v2"},
    "bound_at": {"type": "string"},
    "agent_run_id": {"type": "string"},
    "run_dir": {"type": "string"},
    "job_id": {"type": "string"},
    "ticket_id": {"type": "string"},
    "pack_root": {"type": "string"},
    "worktree": {"type": "string"},
    "worktree_target": {"type": "string"},
    "prompt_source_path": {"type": "string"},
    "job_source_path": {"type": "string"},
    "job_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job_stored_path": {"type": "string"},
    "job_stored_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_specification": {
      "type": "object",
      "required": [
        "schema", "source_path", "source_sha256", "stored_path", "stored_sha256", "task_refs"
      ],
      "properties": {
        "schema": {"const": "agent-workflow/source-specification-import/v1"},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stored_path": {"type": "string", "minLength": 1},
        "stored_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "path_policy": {
      "type": "object",
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {"type": "array", "items": {"type": "string"}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "acceptance_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "argv", "cwd", "timeout_seconds", "result_format", "junit_path"],
        "properties": {
          "id": {"type": "string"},
          "argv": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "integer"},
          "result_format": {"type": "string"},
          "junit_path": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "acceptance_command_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "acceptance_command_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "review_requirement": {
      "type": "object",
      "required": ["required", "independent"],
      "properties": {
        "required": {"type": "boolean"},
        "independent": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
