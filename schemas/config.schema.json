{
  "$defs": {
    "agent_class": {
      "additionalProperties": false,
      "properties": {
        "default_executor": {
          "type": "string"
        },
        "default_model": {
          "type": "string"
        },
        "interactive": {
          "type": "boolean"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/strings"
          },
          "type": "object"
        }
      },
      "required": [
        "interactive",
        "default_executor",
        "default_model"
      ],
      "type": "object"
    },
    "agents": {
      "additionalProperties": false,
      "properties": {
        "default_class": {
          "type": "string"
        },
        "default_executor": {
          "type": "string"
        },
        "generated_prefix": {
          "type": "string"
        },
        "preferred_names": {
          "$ref": "#/$defs/strings"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/profile"
          },
          "description": "Legacy operator compatibility only; normal role-first launches ignore named profiles unless a low-level compatibility override is explicit.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "decision_policy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "minLength": 1,
          "type": "string"
        },
        "profile": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "decision_profile": {
      "additionalProperties": {
        "$ref": "#/$defs/decision_rule"
      },
      "type": "object"
    },
    "decision_rule": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "shadow",
            "advisory",
            "automated"
          ]
        },
        "minimum_confidence": {
          "maximum": 1.0,
          "minimum": 0.5,
          "type": "number"
        }
      },
      "type": "object"
    },
    "executor": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/strings"
        },
        "default_model": {
          "type": "string"
        },
        "environment_allowlist": {
          "$ref": "#/$defs/strings"
        },
        "interactive_command": {
          "$ref": "#/$defs/strings"
        },
        "interactive_permission_args": {
          "$ref": "#/$defs/strings"
        },
        "model_arg": {
          "$ref": "#/$defs/strings"
        },
        "models": {
          "$ref": "#/$defs/strings"
        },
        "no_go_models": {
          "$ref": "#/$defs/strings"
        },
        "non_interactive_permission_args": {
          "$ref": "#/$defs/strings"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "steering_adapter": {
          "enum": [
            "unsupported",
            "control-file-v1"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "git": {
      "additionalProperties": false,
      "properties": {
        "branch_prefix": {
          "type": "string"
        },
        "repository_allowlist": {
          "$ref": "#/$defs/strings"
        },
        "require_clean_source": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "pack": {
      "additionalProperties": false,
      "properties": {
        "archive_level": {
          "type": "integer"
        },
        "validate_before_archive": {
          "type": "boolean"
        },
        "write_sha256": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "paths": {
      "additionalProperties": false,
      "properties": {
        "state_root": {
          "type": "string"
        },
        "worktree_root": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "plugins": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/$defs/strings"
        }
      },
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "description": "Legacy operator compatibility profile. Normal orchestration uses logical roles and private runtime aliases; profiles do not implicitly select a runtime.",
      "properties": {
        "allow_no_go_model": {
          "type": "boolean"
        },
        "class": {
          "type": "string"
        },
        "executor": {
          "type": "string"
        },
        "interactive": {
          "type": "boolean"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "executor",
        "model"
      ],
      "type": "object"
    },
    "roles": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "default": {
          "minLength": 1,
          "type": "string"
        },
        "paths": {
          "$ref": "#/$defs/strings"
        }
      },
      "type": "object"
    },
    "runtime_alias": {
      "additionalProperties": false,
      "properties": {
        "executor": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "executor",
        "model"
      ],
      "type": "object"
    },
    "security": {
      "additionalProperties": false,
      "properties": {
        "executable_digest": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "local",
            "governed",
            "release"
          ]
        },
        "policy_files": {
          "$ref": "#/$defs/strings"
        }
      },
      "type": "object"
    },
    "strings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "supervisor": {
      "additionalProperties": false,
      "properties": {
        "capture_interactive": {
          "type": "boolean"
        },
        "capture_lines": {
          "minimum": 1,
          "type": "integer"
        },
        "interrupt_stalled": {
          "type": "boolean"
        },
        "interval_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "max_remediation_attempts": {
          "minimum": 1,
          "type": "integer"
        },
        "probe_stalled": {
          "type": "boolean"
        },
        "restart_orphaned": {
          "type": "boolean"
        },
        "sync_index": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$id": "agent-workflow/config/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_classes": {
      "additionalProperties": {
        "$ref": "#/$defs/agent_class"
      },
      "type": "object"
    },
    "agents": {
      "$ref": "#/$defs/agents"
    },
    "decision_policy": {
      "$ref": "#/$defs/decision_policy"
    },
    "decision_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/decision_profile"
      },
      "type": "object"
    },
    "executors": {
      "additionalProperties": {
        "$ref": "#/$defs/executor"
      },
      "type": "object"
    },
    "git": {
      "$ref": "#/$defs/git"
    },
    "pack": {
      "$ref": "#/$defs/pack"
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "plugins": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/$defs/strings"
        }
      },
      "type": "object"
    },
    "roles": {
      "$ref": "#/$defs/roles"
    },
    "runtime_aliases": {
      "additionalProperties": {
        "$ref": "#/$defs/runtime_alias"
      },
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "supervisor": {
      "$ref": "#/$defs/supervisor"
    },
    "semantic": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "typesafe",
          "type": "string"
        },
        "typesafe": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "api_call_log": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "agent-workflow user policy",
  "type": "object"
}
