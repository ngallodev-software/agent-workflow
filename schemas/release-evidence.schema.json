{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/release-evidence.schema.json",
  "title": "agent-workflow release evidence summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "version", "status", "generated_at", "checks", "evidence", "technical_exit_code"],
  "properties": {
    "schema": {"const": "agent-workflow/release-evidence/v1"},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked", "technical_failure"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "technical_exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "status": {"enum": ["pass", "blocked", "fail", "not_run"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 1000},
          "backlog_id": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+$"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "dependency_lock", "sbom", "provenance", "test_results"],
      "properties": {
        "policy": {"$ref": "#/$defs/fileEvidence"},
        "dependency_lock": {"$ref": "#/$defs/fileEvidence"},
        "sbom": {"$ref": "#/$defs/fileEvidence"},
        "provenance": {"$ref": "#/$defs/fileEvidence"},
        "test_results": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/fileEvidence"}
          ]
        }
      }
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}

