{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/handling-disposition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "consumer_id", "consumer_identity_digest", "source_journal_id", "source_sequence", "source_message_id", "source_message_digest", "disposition", "target_receipt_id", "updated_at"],
  "properties": {
    "schema": {"const": "agent-workflow/handling-disposition/v1"},
    "schema_version": {"const": 1},
    "consumer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "consumer_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_journal_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_sequence": {"type": "integer", "minimum": 1},
    "source_message_id": {"type": "string", "format": "uuid"},
    "source_message_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "disposition": {"enum": ["applied", "rejected", "ignored", "deferred", "security_error"]},
    "target_receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
