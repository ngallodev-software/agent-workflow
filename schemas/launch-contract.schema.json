{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/launch-contract/v1",
  "type": "object",
  "required": ["schema", "version", "session", "ticket", "pack", "worktree", "prompt", "command_plan", "paths", "schemas", "runtime_policy", "evaluation_policy", "source_baseline", "expected_outputs"],
  "properties": {
    "schema": {"const": "agent-workflow/launch-contract/v1"},
    "version": {"const": 1},
    "session": {"type": "object", "required": ["id", "agent_name", "agent_class", "tier", "retry_of", "created_at"], "properties": {"id": {"type": "string"}, "agent_name": {"type": ["string", "null"]}, "agent_class": {"type": ["string", "null"]}, "tier": {"type": ["string", "null"]}, "retry_of": {"type": ["string", "null"]}, "created_at": {"type": "string"}}, "additionalProperties": false},
    "ticket": {"type": ["string", "null"]},
    "pack": {"type": "object", "required": ["id", "root", "manifest_sha256"], "properties": {"id": {"type": ["string", "null"]}, "root": {"type": ["string", "null"]}, "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "worktree": {"type": "object", "required": ["path", "source_revision", "branch", "dirty_at_launch"], "properties": {"path": {"type": "string"}, "source_revision": {"type": ["string", "null"]}, "branch": {"type": ["string", "null"]}, "dirty_at_launch": {"type": ["boolean", "null"]}}, "additionalProperties": false},
    "prompt": {"type": "object", "required": ["source", "stored", "sha256", "launch_stored", "launch_sha256"], "properties": {"source": {"type": "string"}, "stored": {"const": "prompt.md"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "launch_stored": {"const": "launch-prompt.md"}, "launch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "command_plan": {"type": "object", "required": ["argv", "command_sha256", "stream_format", "interactive", "executor_interactive", "environment_allowlist"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stream_format": {"enum": ["text", "codex-jsonl", "claude-stream-json"]}, "interactive": {"type": "boolean"}, "executor_interactive": {"type": "boolean"}, "environment_allowlist": {"type": "array", "items": {"type": "string"}}, "executor": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}}, "additionalProperties": false},
    "paths": {"type": "object", "required": ["run_dir", "workdir", "handoff_dir", "completion", "result", "result_contract", "runtime", "source_baseline"], "properties": {"run_dir": {"const": "."}, "workdir": {"type": "string"}, "handoff_dir": {"type": "string"}, "completion": {"const": "completion.json"}, "result": {"const": "result.json"}, "result_contract": {"type": ["object", "null"]}, "runtime": {"const": "evaluation-runtime.json"}, "source_baseline": {"const": "source-baseline.json"}}, "additionalProperties": false},
    "schemas": {"type": "object", "required": ["launch", "completion", "provenance", "status", "source_baseline", "completion_collection", "task_result"], "additionalProperties": {"type": ["object", "null"], "properties": {"id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["id", "sha256"], "additionalProperties": false}},
    "runtime_policy": {"type": "object"},
    "evaluation_policy": {"type": "object"},
    "source_baseline": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"const": "source-baseline.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "expected_outputs": {"type": "object", "required": ["output_log", "executor_events", "executor_stderr", "final_status", "final_receipt"], "properties": {"output_log": {"const": "output.log"}, "executor_events": {"const": "executor-events.jsonl"}, "executor_stderr": {"const": "executor-stderr.log"}, "final_status": {"const": "final-status.json"}, "final_receipt": {"const": "final-receipt.json"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
