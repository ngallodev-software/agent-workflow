{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/orchestrator-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "orchestrator_id", "workflow_id", "principal", "identity_digest", "state", "created_at", "updated_at", "children"],
  "properties": {
    "schema": {"const": "agent-workflow/orchestrator-registry/v1"},
    "schema_version": {"const": 1},
    "orchestrator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "workflow_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "principal": {"const": "orchestrator"},
    "identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"enum": ["active", "completed", "abandoned"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "children": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/child"}}
  },
  "$defs": {
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "session_id", "assignment_id", "launch_contract_path", "launch_contract_digest", "source_journal_path", "source_journal_id", "worktree", "agent_name", "registered_at", "state", "unregistered_at", "identity_digest"],
      "properties": {
        "schema": {"const": "agent-workflow/orchestrator-child/v1"},
        "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "assignment_id": {"type": "string", "format": "uuid"},
        "launch_contract_path": {"type": "string", "minLength": 1},
        "launch_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_journal_path": {"type": "string", "minLength": 1},
        "source_journal_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "worktree": {"type": "string", "minLength": 1},
        "agent_name": {"type": ["string", "null"]},
        "registered_at": {"type": "string", "minLength": 1},
        "state": {"enum": ["active", "completed", "abandoned"]},
        "unregistered_at": {"type": ["string", "null"]},
        "identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
