{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/worker-completion-draft/v1",
  "type": "object",
  "required": [
    "schema",
    "agent_run_id",
    "state",
    "criteria",
    "limitations",
    "commands",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/worker-completion-draft/v1"
    },
    "agent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "open",
        "finalized"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_verified"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "not_verified"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "argv",
          "cwd",
          "exit_code",
          "receipt"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "receipt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "final_result": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "final_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
