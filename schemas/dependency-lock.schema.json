{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/dependency-lock.schema.json",
  "title": "agent-workflow direct dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "version", "scope", "follow_up", "packages"],
  "properties": {
    "schema": {"const": "agent-workflow/dependency-lock/v1"},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "scope": {"const": "direct-dependencies"},
    "follow_up": {"const": "HARD-010"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "groups", "source_requirements"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+!-]*$"},
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
          },
          "source_requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

