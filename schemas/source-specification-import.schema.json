{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/source-specification-import/v1",
  "type": "object",
  "required": [
    "schema", "provider", "workflow_schema", "change", "repository",
    "validation", "status", "apply", "artifacts", "task_map", "importer", "created_at"
  ],
  "properties": {
    "schema": {"const": "agent-workflow/source-specification-import/v1"},
    "provider": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "openspec"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "workflow_schema": {
      "type": "object",
      "required": ["name", "version", "source", "schema_sha256", "templates"],
      "properties": {
        "name": {"const": "spec-driven"},
        "version": {"const": 1},
        "source": {"const": "package"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "templates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["path", "revision", "branch", "dirty"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "branch": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "validation": {"$ref": "#/$defs/report"},
    "status": {
      "allOf": [
        {"$ref": "#/$defs/report"},
        {
          "type": "object",
          "required": ["is_complete"],
          "properties": {"is_complete": {"const": true}}
        }
      ]
    },
    "apply": {
      "allOf": [
        {"$ref": "#/$defs/report"},
        {
          "type": "object",
          "required": ["state"],
          "properties": {"state": {"enum": ["ready", "all_done"]}}
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "source_path", "stored_path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "stored_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "task_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent_workflow_task_id", "description", "source"],
        "properties": {
          "agent_workflow_task_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "required": ["artifact", "locator", "text_sha256", "source_path", "line"],
            "properties": {
              "artifact": {"const": "tasks"},
              "locator": {"type": "string", "minLength": 1},
              "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_path": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "importer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agent-workflow"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "report": {
      "type": "object",
      "required": ["argv", "sha256"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "is_complete": {"type": "boolean"},
        "state": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
