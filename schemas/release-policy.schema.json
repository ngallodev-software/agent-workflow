{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/release-policy.schema.json",
  "title": "agent-workflow release policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "version",
    "license",
    "security_channel",
    "compatibility"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/release-policy/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "allOf": [
        {
          "$ref": "#/$defs/governanceDecision"
        },
        {
          "type": "object",
          "properties": {
            "backlog_id": {
              "const": "REL-001"
            }
          }
        }
      ]
    },
    "security_channel": {
      "allOf": [
        {
          "$ref": "#/$defs/governanceDecision"
        },
        {
          "type": "object",
          "properties": {
            "contact": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 3
            },
            "response_policy": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 3
            },
            "backlog_id": {
              "const": "REL-002"
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "backlog_id",
        "matrix_id",
        "combinations",
        "evidence_required"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "supported",
            "blocked"
          ]
        },
        "backlog_id": {
          "const": "REL-003"
        },
        "matrix_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "evidence_required": {
          "type": "boolean"
        },
        "combinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/compatibilityCombination"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "governanceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "backlog_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "configured",
            "blocked"
          ]
        },
        "backlog_id": {
          "type": "string",
          "pattern": "^REL-[0-9]{3}$"
        },
        "spdx_expression": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "distribution_policy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "contact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "response_policy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        }
      }
    },
    "compatibilityCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "host",
        "python",
        "tmux",
        "executor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "status": {
          "enum": [
            "candidate",
            "verified",
            "unsupported"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "tmux": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "executor_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combination_id",
        "path",
        "sha256"
      ],
      "properties": {
        "combination_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}

