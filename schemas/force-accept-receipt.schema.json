{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/force-accept-receipt/v1",
  "type": "object",
  "required": ["schema", "agent_run_id", "actor", "created_at", "reason", "acknowledgement", "command", "command_sha256", "final_receipt_sha256", "normal_gate_failures"],
  "properties": {
    "schema": {"const": "agent-workflow/force-accept-receipt/v1"},
    "agent_run_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "acknowledgement": {"const": "FORCE-ACCEPT"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normal_gate_failures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
