{
  "argv_template": [
    "claude",
    "--print",
    "--verbose",
    "--output-format",
    "stream-json",
    "--permission-mode",
    "acceptEdits",
    "--no-session-persistence",
    "--model",
    "{model}"
  ],
  "authentication": {
    "allow_api_key_fallback": false,
    "credential_environment": [
      "ANTHROPIC_API_KEY"
    ],
    "mode": "api-key",
    "status_argv": [],
    "status_timeout_seconds": 5
  },
  "billing": {
    "mode": "metered-api",
    "provider_billed_cost_semantics": "reported",
    "subscription_allocation": {
      "amount": null,
      "method": "none"
    },
    "subscription_plan": null
  },
  "currency": "USD",
  "effort": "default",
  "environment": {},
  "environment_allowlist": [
    "HOME",
    "USER",
    "LOGNAME",
    "PATH",
    "SHELL",
    "TERM",
    "TMPDIR",
    "XDG_CONFIG_HOME",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "CLAUDE_CONFIG_DIR",
    "ANTHROPIC_API_KEY"
  ],
  "executor": "claude-code-cli",
  "executor_version": "runtime-detected",
  "max_stderr_bytes": 4194304,
  "max_stdout_bytes": 16777216,
  "model": "sonnet",
  "nonzero_classification": "infrastructure",
  "price_catalog_id": null,
  "pricing": {
    "input_tokens_include_cached": true,
    "usd_per_million_tokens": {
      "cache_write_input": null,
      "cached_input": null,
      "input": null,
      "output": null,
      "reasoning_output": null
    }
  },
  "prompt_delivery": {
    "append_newline": true,
    "source": "stdin-prompt-file"
  },
  "provider": "anthropic",
  "sandbox": {
    "adapter": "claude-accept-edits",
    "argv_prefix": [],
    "verified_isolation": false
  },
  "schema": "agent-workflow/benchmark-executor-config/v1",
  "timeout_seconds": 150,
  "tool_policy": {
    "authentication": "optional API key",
    "filesystem": "Claude acceptEdits plus post-run scope audit",
    "hidden_oracle": "not present in target worktree",
    "network": "provider-cli-policy"
  },
  "unsafe_inherit_environment": false
}
